{
  "name": "dsh-model-relay",
  "displayName": "模型中转站",
  "version": "0.1.1",
  "description": "Model relay station for DeepSeek Harness (模型中转站): serve any registered DSH LLM provider (e.g. @tnnevol/dsh-codebuddy) over an OpenAI-compatible /v1 API, so other projects can call those models with a standard OpenAI client.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "qilin-zhu",
  "homepage": "https://github.com/qilin-zhu/dsh-model-relay",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qilin-zhu/dsh-model-relay.git"
  },
  "bugs": {
    "url": "https://github.com/qilin-zhu/dsh-model-relay/issues"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": "0.1.2-rc.1 || ^0.1.5-rc.2 || ^0.1.6-alpha.1"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./compatibility.json": "./compatibility.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "compatibility.json",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "openai",
    "openai-compatible",
    "model-relay",
    "gateway",
    "codebuddy"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-connection"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-attachment": "0.1.2-rc.1 || ^0.1.5-rc.2 || ^0.1.6-alpha.1",
    "@deepseek-ai/dsh-client-locale": "0.1.2-rc.1 || ^0.1.5-rc.2 || ^0.1.6-alpha.1",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.2-rc.1 || ^0.1.5-rc.2 || ^0.1.6-alpha.1",
    "@deepseek-ai/dsh-home-paths": "0.1.2-rc.1 || ^0.1.5-rc.2 || ^0.1.6-alpha.1",
    "@deepseek-ai/dsh-host-webserver": "0.1.2-rc.1 || ^0.1.5-rc.2 || ^0.1.6-alpha.1",
    "@deepseek-ai/dsh-llm": "0.1.2-rc.1 || ^0.1.5-rc.2 || ^0.1.6-alpha.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-attachment": {
      "optional": true
    }
  },
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/keys.js && node --check lib/client.js",
    "test": "node test/gateway.test.mjs && node test/keys.test.mjs"
  }
}
